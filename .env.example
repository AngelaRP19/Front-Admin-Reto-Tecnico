# URL base del backend (API Java).
# Dejar VACÍO en desarrollo: las peticiones salen como rutas relativas y Vite las reenvía
# al backend real vía el proxy de vite.config.js — evita el bloqueo de CORS del backend,
# que hoy solo permite el origen http://localhost:5173 (ocupado por Front-Reto-T-cnico).
# En producción (sin proxy de Vite) hay que poner acá la URL real del backend.
VITE_API_URL=

# Clave AES-256-GCM (base64) para encriptar el body de /auth/login.
# Tiene que coincidir con crypto.secret-key del backend (application.yml / CRYPTO_SECRET_KEY).
# Misma clave que usa Front-Reto-T-cnico, porque ambos frontends hablan con el mismo backend.
VITE_CRYPTO_SECRET_KEY=ILluF20Aavb5J6XZ/qw67TSAQxkCPoi3IWQs1fI2sYA=
